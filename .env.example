# Example Environment Configuration (copy to .env and replace placeholders)
DATABASE_URL=postgresql://postgres:ganesh@localhost:5432/hla_db
PORT=5000
FLASK_ENV=development

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_USE_TLS=true

# Local Ollama AI Assistant Configuration
OLLAMA_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_AUTO_START=true
OLLAMA_AUTO_PULL=false
OLLAMA_STARTUP_TIMEOUT=60
OLLAMA_STATUS_POLL_INTERVAL=2
